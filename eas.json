{
  "cli": {
    "version": ">= 13.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "node": "20.19.4",
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.2"
      },
      "env": {
        "EXPO_PUBLIC_DEPLOY_ENV": "development"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "store",
      "environment": "preview",
      "autoIncrement": true,
      "node": "20.19.4",
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.2"
      },
      "env": {
        "EXPO_PUBLIC_DEPLOY_ENV": "preview"
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "node": "20.19.4",
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.2"
      },
      "env": {
        "EXPO_PUBLIC_DEPLOY_ENV": "production"
      }
    },
    "e2e-test": {
      "withoutCredentials": true,
      "environment": "development",
      "node": "20.19.4",
      "ios": {
        "simulator": true,
        "image": "macos-sequoia-15.6-xcode-26.2"
      },
      "env": {
        "EXPO_PUBLIC_DEPLOY_ENV": "development"
      }
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "ascAppId": "6836653723"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6836653723"
      }
    }
  }
}
