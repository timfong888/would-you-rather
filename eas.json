{
  "cli": {
    "version": ">= 13.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "node": "20.18.0"
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "store",
      "environment": "preview",
      "autoIncrement": true,
      "node": "20.18.0"
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "node": "20.18.0"
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "ascAppId": "6836653723"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6836653723"
      }
    }
  }
}
