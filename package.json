{
  "name": "would-you-rather",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "EXPO_PUBLIC_DEPLOY_ENV=${EXPO_PUBLIC_DEPLOY_ENV:-development} expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "EXPO_PUBLIC_DEPLOY_ENV=${EXPO_PUBLIC_DEPLOY_ENV:-development} expo start --web",
    "export:web": "expo export --platform web",
    "verify:attribution": "tsx scripts/verify-attribution.ts",
    "build:web": "node scripts/check-web-build.mjs && npm run verify:data && npm run verify:attribution && npm run generate:sitemap && EXPO_PUBLIC_DEPLOY_ENV=${VERCEL_ENV:-${EXPO_PUBLIC_DEPLOY_ENV:-development}} expo export --clear --platform web && node scripts/check-web-build.mjs --dist dist && node scripts/web-export-compat.mjs && node scripts/generate-sharing-pages.mjs && node scripts/generate-question-pages.mjs && node scripts/generate-guide-pages.mjs && node scripts/inject-smart-banner.mjs && npm run verify:seo -- --dist",
    "generate:sitemap": "tsx scripts/generate-sitemap.ts",
    "verify:data": "tsx scripts/verify-questions.ts",
    "owner:hash": "node scripts/owner-code-hash.mjs",
    "verify:seo": "tsx scripts/verify-seo.ts",
    "test": "tsx --test tests/unit/*.test.ts && tsx --tsconfig tests/tsconfig.analytics.json --test tests/analytics/*.test.ts",
    "report:daily": "tsx scripts/report.ts daily",
    "report:seo": "tsx scripts/report.ts seo",
    "db:migrate": "node scripts/migrate-db.mjs",
    "rc:sync": "tsx scripts/revenuecat/sync-catalog.ts",
    "eas-build-pre-install": "node scripts/check-rc-keys.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@neondatabase/serverless": "^1.2.1",
    "@revenuecat/purchases-js": "1.74.0",
    "@vercel/og": "^0.11.1",
    "expo": "~54.0.0",
    "expo-application": "~7.0.8",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "posthog-react-native": "^4.63.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-purchases": "^9.15.3",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@electric-sql/pglite": "^0.5.16",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.12",
    "tsx": "^4.23.1",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "@xmldom/xmldom": ">=0.9.10",
    "postcss": ">=8.5.12",
    "tar": ">=7.5.19",
    "turbo-stream": "^3.0.0",
    "@expo/plist": {
      "@xmldom/xmldom": "~0.8.15"
    },
    "plist": {
      "@xmldom/xmldom": "^0.8.8"
    }
  }
}
