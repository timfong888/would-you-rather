{
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/game/:id",
      "destination": "/game/[id].html"
    },
    {
      "source": "/results/:id",
      "destination": "/results/[id].html"
    },
    {
      "source": "/categories/:id",
      "destination": "/categories/[id].html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
