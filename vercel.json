{
  "buildCommand": "npm run build:web && cp -r dist/. public/",
  "outputDirectory": "public",
  "framework": null,
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ],
  "rewrites": [
    { "source": "/p/:id",                                               "destination": "/p/:id.html" },
    { "source": "/game/:id",                                            "destination": "/game/[id].html" },
    { "source": "/results/:id",                                         "destination": "/results/[id].html" },
    { "source": "/categories/:id",                                      "destination": "/categories/[id].html" },
    { "source": "/complete/:id",                                        "destination": "/complete/[id].html" },
    { "source": "/unlock/:id",                                          "destination": "/unlock/[id].html" },
    { "source": "/categories",                                          "destination": "/categories.html" },
    { "source": "/privacy",                                             "destination": "/privacy.html" },
    { "source": "/support",                                             "destination": "/support.html" },
    { "source": "/terms",                                               "destination": "/terms.html" },
    { "source": "/would-you-rather-questions-for-kids",                 "destination": "/would-you-rather-questions-for-kids.html" },
    { "source": "/dinner-table-conversation-starters",                  "destination": "/dinner-table-conversation-starters.html" },
    { "source": "/deep-would-you-rather-questions",                     "destination": "/deep-would-you-rather-questions.html" },
    { "source": "/questions-for-couples",                               "destination": "/questions-for-couples.html" },
    { "source": "/funny-would-you-rather-questions-for-kids",           "destination": "/funny-would-you-rather-questions-for-kids.html" },
    { "source": "/would-you-rather-questions-for-kindergarten",         "destination": "/would-you-rather-questions-for-kindergarten.html" },
    { "source": "/would-you-rather-questions-for-elementary-students",  "destination": "/would-you-rather-questions-for-elementary-students.html" },
    { "source": "/gross-would-you-rather-questions",                    "destination": "/gross-would-you-rather-questions.html" },
    { "source": "/this-or-that-questions-for-kids",                     "destination": "/this-or-that-questions-for-kids.html" },
    { "source": "/thanksgiving-would-you-rather-questions",             "destination": "/thanksgiving-would-you-rather-questions.html" },
    { "source": "/christmas-would-you-rather-questions-for-kids",       "destination": "/christmas-would-you-rather-questions-for-kids.html" },
    { "source": "/would-you-rather-questions-for-family",               "destination": "/would-you-rather-questions-for-family.html" },
    { "source": "/road-trip-would-you-rather-questions",                "destination": "/road-trip-would-you-rather-questions.html" },
    { "source": "/would-you-rather-app",                                "destination": "/would-you-rather-app.html" },
    { "source": "/((?!api/).*)",                                        "destination": "/index.html" }
  ]
}
